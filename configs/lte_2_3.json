          "settings": {
            "maxRTT": "2000ms",
            "expected": 3,
            "baselines": [
              "1200ms"
            ],
            "tolerance": 0.1
          }
        },
        "fallbackTag": "direct"
      }
    ]
  },
  "inbounds": [
