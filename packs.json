        "tag": "socks",
        "port": 10808,
        "listen": "127.0.0.1",
        "protocol": "socks",
        "settings": {
          "udp": true,
          "auth": "noauth"
        },
        "sniffing": {
          "enabled": true,
          "routeOnly": false,
          "destOverride": [
            "http",
            "tls",
            "quic"
