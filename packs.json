            "socks",
            "http"
          ],
          "balancerTag": "BALANCER"
        }
      ],
      "balancers": [
        {
          "tag": "BALANCER",
          "selector": [
            "lte-"
          ],
          "strategy": {
            "type": "leastPing"
          }
        }
      ]
    },
