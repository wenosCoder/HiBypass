        {
          "type": "field",
          "protocol": [
            "bittorrent"
          ],
          "outboundTag": "direct"
        },
        {
          "type": "field",
          "inboundTag": [
            "socks",
            "http"
          ],
          "balancerTag": "BALANCER"
        }
      ],
      "balancers": [
        {
          "tag": "BALANCER",
          "selector": [
            "lte-"
          ],
          "strategy": {
            "type": "leastPing"
          }
        }
      ]
    },
