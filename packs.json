[
  {
    "remarks": "🇪🇺LTE | 1.1 🌐",
    "dns": {
      "queryStrategy": "UseIP",
      "servers": [
        "1.1.1.1",
        "8.8.8.8",
        "tls://1.1.1.1",
        "https://dns.google/dns-query",
        "https://cloudflare-dns.com/dns-query"
      ]
